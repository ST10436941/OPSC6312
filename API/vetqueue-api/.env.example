# Copy this file to .env for local development.
# On your host (Render / Railway / etc.) set these as real environment
# variables in their dashboard instead - never commit a real .env file.

# Full Postgres connection string, e.g.:
# postgres://user:password@host:5432/dbname
# Most hosted Postgres providers give you this exact string - paste it as-is.
DATABASE_URL=postgres://vetqueue:vetqueue@localhost:5432/vetqueue

# Render/Railway/Heroku-style managed Postgres requires SSL - set to "true"
# there. Leave "false" for a local Postgres install with no SSL configured.
DATABASE_SSL=false

PORT=3000

# PLACEHOLDER (optional): push notifications. Paste your Firebase service-account
# key (Firebase console -> Project settings -> Service accounts -> Generate new
# private key) as ONE line of JSON. Leave empty to run without push delivery.
FIREBASE_SERVICE_ACCOUNT_JSON=
